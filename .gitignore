# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
README 2.md

# local Jarvis task queue
jarvis/inbox/*.md
jarvis/working/*.md
jarvis/outbox/*.md
jarvis/second-brain/inbox/*.md

# generated daily reports
reports/*.md
reports/*.json
reports/search-console-opportunities/*
!reports/search-console-opportunities/.gitkeep

# generated social reports
social-content/reports/

# generated cluster expansion reports
reports/clusters/*

# generated traffic intelligence reports
reports/traffic/*

# optional analytics imports
analytics/exports/*

# growth operating system
growth/state/*
reports/growth/*
!reports/growth/.gitkeep
!growth/README.md

# manual Search Console exports
search-console/exports/*
!search-console/exports/.gitkeep
